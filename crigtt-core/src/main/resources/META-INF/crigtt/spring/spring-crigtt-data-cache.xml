    <beans:bean id="cacheManager" class="gov.hhs.onc.crigtt.data.cache.impl.CrigttCacheManagerFactoryBean"
        parent="cacheManagerCrigtt">
    </beans:bean>
    -->

    <!--====================================================================================================
    = CACHES - Spring Boot 3.x compatible configuration
    =====================================================================================================-->
